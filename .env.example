# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/atsify

# Auth
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
SALT_ROUND=10

# AI
GROQ_API_KEY=replace-with-groq-api-key
GOOGLE_API_KEY=replace-with-google-api-key

# Google Drive integration (required for resume storage)
GOOGLE_DRIVE_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=replace-with-oauth-refresh-token
GOOGLE_DRIVE_BASE_FOLDER_ID=replace-with-parent-folder-id
# Optional override. Keep this default when using OAuth Playground.
GOOGLE_DRIVE_REDIRECT_URI=https://developers.google.com/oauthplayground
